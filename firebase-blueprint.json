{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Compte utilisateur privé incluant les informations personnelles identifiables (PII) et les paramètres d'accès.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "enum": ["employee", "manager", "admin"] },
        "position": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "accountStatus": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "emailVerified": { "type": "boolean" },
        "photoURL": { "type": "string", "maxLength": 500 },
        "timezone": { "type": "string", "maxLength": 64 },
        "notificationPreferences": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "firstName", "lastName", "email", "role", "accountStatus", "emailVerified", "timezone", "createdAt", "updatedAt"]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Annuaire public interne d'entreprise sans PII (aucun e-mail ni téléphone) pour afficher les collaborateurs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["employee", "manager", "admin"] },
        "position": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "accountStatus": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "photoURL": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "firstName", "lastName", "role", "accountStatus", "updatedAt"]
    },
    "OrganizationSetting": {
      "title": "OrganizationSetting",
      "description": "Paramètres globaux de l'entreprise configurés par l'administrateur.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "timezone": { "type": "string", "maxLength": 64 },
        "reminderTime": { "type": "string", "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "requireAdminActivation": { "type": "boolean" },
        "requirePersonalTaskApproval": { "type": "boolean" },
        "weeklyReportDay": { "type": "string", "enum": ["monday", "sunday"] },
        "weeklyReportTime": { "type": "string", "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "timezone", "reminderTime", "requireAdminActivation", "requirePersonalTaskApproval", "weeklyReportDay", "weeklyReportTime", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Tâche personnelle ou tâche issue d'une mission acceptée.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "maxLength": 160 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "maxLength": 160 },
        "source": { "type": "string", "enum": ["personal", "mission"] },
        "missionId": { "type": "string", "maxLength": 128 },
        "assignmentId": { "type": "string", "maxLength": 256 },
        "startAt": { "type": "string", "maxLength": 40 },
        "plannedDate": { "type": "string", "maxLength": 40 },
        "dueAt": { "type": "string", "maxLength": 40 },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "category": { "type": "string", "maxLength": 80 },
        "labelIds": { "type": "array", "description": "Identifiants d'étiquettes personnalisées (maximum 8)." },
        "status": { "type": "string", "enum": ["todo", "in_progress", "blocked", "submitted", "changes_requested", "completed", "cancelled"] },
        "publicationStatus": { "type": "string", "enum": ["draft", "published"] },
        "progressMode": { "type": "string", "enum": ["auto", "manual"] },
        "progress": { "type": "number" },
        "subtaskCount": { "type": "number" },
        "completedSubtaskCount": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "createdBy", "ownerId", "source", "startAt", "plannedDate", "dueAt", "priority", "category", "status", "publicationStatus", "progressMode", "progress", "createdAt", "updatedAt"]
    },
    "Subtask": {
      "title": "Subtask",
      "description": "Étape individuelle d'une tâche permettant le calcul automatique de progression.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "order": { "type": "number" },
        "completed": { "type": "boolean" },
        "completedBy": { "type": "string", "maxLength": 128 },
        "completedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "publicationStatus": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "order", "completed", "ownerId", "publicationStatus", "createdAt"]
    },
    "Mission": {
      "title": "Mission",
      "description": "Mission principale créée par un responsable ou administrateur et attribuable à plusieurs employés.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "objectives": { "type": "string", "maxLength": 2000 },
        "instructions": { "type": "string", "maxLength": 4000 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "maxLength": 160 },
        "startAt": { "type": "string", "maxLength": 40 },
        "dueAt": { "type": "string", "maxLength": 40 },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "status": { "type": "string", "enum": ["draft", "published", "closed", "cancelled"] },
        "category": { "type": "string", "maxLength": 80 },
        "checklistTemplate": { "type": "array" },
        "assignedEmployeeIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "objectives", "instructions", "createdBy", "startAt", "dueAt", "priority", "status", "assignedEmployeeIds", "createdAt", "updatedAt"]
    },
    "MissionAssignment": {
      "title": "MissionAssignment",
      "description": "Affectation individuelle indépendante d'une mission à un collaborateur.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "missionTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "maxLength": 160 },
        "assignedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedByName": { "type": "string", "maxLength": 160 },
        "acceptanceStatus": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "workStatus": { "type": "string", "enum": ["not_started", "in_progress", "blocked", "submitted", "changes_requested", "approved"] },
        "taskId": { "type": "string", "maxLength": 128 },
        "progress": { "type": "number" },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "startAt": { "type": "string", "maxLength": 40 },
        "dueAt": { "type": "string", "maxLength": 40 },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string", "maxLength": 1000 },
        "submittedAt": { "type": "string", "format": "date-time" },
        "submissionNote": { "type": "string", "maxLength": 2000 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewComment": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "missionTitle", "employeeId", "assignedBy", "acceptanceStatus", "workStatus", "progress", "priority", "dueAt", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notification événementielle ou rappel quotidien interne.",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["mission_assigned", "mission_accepted", "mission_rejected", "task_due_soon", "task_overdue", "comment_added", "work_submitted", "work_approved", "changes_requested", "daily_reminder", "account_activated"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "entityType": { "type": "string", "enum": ["task", "mission", "assignment", "report", "account"] },
        "entityId": { "type": "string", "maxLength": 128 },
        "readAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "type", "title", "message", "entityType", "entityId", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Commentaire collaboratif sur une tâche ou une mission.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string", "maxLength": 128 },
        "missionId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "maxLength": 160 },
        "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "visibility": { "type": "string", "enum": ["company", "private"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "content", "visibility", "createdAt", "updatedAt"]
    },
    "DeviceToken": {
      "title": "DeviceToken",
      "description": "Enregistrement d'appareil pour notifications push navigateur.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "installationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "platform": { "type": "string", "maxLength": 64 },
        "token": { "type": "string", "maxLength": 512 },
        "enabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "installationId", "platform", "enabled", "updatedAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Rapport d'activité individuel ou collectif calculé sur une période définie.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["individual", "collective"] },
        "periodKind": { "type": "string", "enum": ["weekly", "monthly", "custom"] },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 160 },
        "periodStart": { "type": "string", "maxLength": 40 },
        "periodEnd": { "type": "string", "maxLength": 40 },
        "totals": { "type": "object" },
        "completionRate": { "type": "number" },
        "generatedBy": { "type": "string", "maxLength": 128 },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "periodKind", "periodStart", "periodEnd", "totals", "completionRate", "generatedAt"]
    },
    "ReminderDelivery": {
      "title": "ReminderDelivery",
      "description": "Journal d'idempotence des rappels quotidiens envoyés à 20h00 Africa/Douala.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "localDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reminderType": { "type": "string", "enum": ["daily_20h", "manual_admin"] },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "taskId", "localDate", "reminderType", "sentAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Journal immuable de sécurité et d'activité opérationnelle.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "maxLength": 160 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entityType": { "type": "string", "enum": ["user", "task", "subtask", "mission", "assignment", "report", "settings", "reminder", "label"] },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["actorUid", "actorName", "action", "entityType", "entityId", "timestamp"]
    },
    "TaskLabel": {
      "title": "TaskLabel",
      "description": "Étiquette personnalisée partagée pour catégoriser les tâches par priorité, département ou type de projet.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "group": { "type": "string", "enum": ["priority", "department", "project_type"] },
        "color": { "type": "string", "enum": ["blue", "navy", "green", "amber", "red", "teal", "slate"] },
        "workspaceVisibility": { "type": "string", "enum": ["company"] },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "group", "color", "workspaceVisibility", "createdBy", "creatorName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Profil privé de l'utilisateur contenant les PII (e-mail, préférences). Accès strictement limité au propriétaire et à l'administrateur."
    },
    "/usersPublic/{uid}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Annuaire interne public d'entreprise sans PII, lisible par les collaborateurs actifs."
    },
    "/organizationSettings/{settingId}": {
      "schema": { "$ref": "#/entities/OrganizationSetting" },
      "description": "Configuration globale de l'entreprise gérée par l'administrateur."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tâches personnelles et tâches d'exécution liées aux missions."
    },
    "/tasks/{taskId}/subtasks/{subtaskId}": {
      "schema": { "$ref": "#/entities/Subtask" },
      "description": "Sous-tâches / étapes d'une tâche pour le calcul automatique de progression."
    },
    "/missions/{missionId}": {
      "schema": { "$ref": "#/entities/Mission" },
      "description": "Missions principales créées par les responsables."
    },
    "/missionAssignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/MissionAssignment" },
      "description": "Affectations individuelles indépendantes d'une mission."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Centre de notifications internes persistantes."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Commentaires associés aux tâches et missions."
    },
    "/deviceTokens/{installationId}": {
      "schema": { "$ref": "#/entities/DeviceToken" },
      "description": "Jetons Web Push par appareil utilisateur."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Rapports hebdomadaires et mensuels individuels et collectifs."
    },
    "/reminderDeliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/ReminderDelivery" },
      "description": "Traçabilité d'idempotence des rappels quotidiens."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Journal immuable des opérations sensibles et d'activité."
    },
    "/taskLabels/{labelId}": {
      "schema": { "$ref": "#/entities/TaskLabel" },
      "description": "Étiquettes personnalisées d'entreprise (priorité, département, type de projet) applicables aux tâches."
    }
  }
}
